# Copie este arquivo para .env.local (ou .env) e preencha os valores reais.
# Nunca faça commit do arquivo preenchido com valores reais.

# --- Banco de dados (Neon Postgres) ---
# Connection string pooled (host com "-pooler"). No Prisma 7, com driver
# adapters, essa mesma URL é usada tanto em runtime quanto para `prisma migrate`
# — não precisa mais de uma DIRECT_URL separada.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Google OAuth / Calendar API ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Ex.: http://localhost:3000/api/auth/google/callback (dev) ou https://seu-dominio.vercel.app/api/auth/google/callback (prod)
GOOGLE_REDIRECT_URI=""

# --- Login do /admin ---
# String aleatória longa usada para criptografar o cookie de sessão (min. 32 caracteres).
SESSION_SECRET=""
# Hash bcrypt da senha de admin. IMPORTANTE: o Next.js expande "$VAR" em
# arquivos .env, então escape cada "$" do hash como "\$" (ex.: "\$2b\$12\$...")
# ou o valor carregado em runtime fica corrompido.
ADMIN_PASSWORD_HASH=""

# --- Gmail SMTP (envio de e-mail) ---
# Sem verificação de domínio necessária — envia pra qualquer destinatário.
# GMAIL_APP_PASSWORD é uma "senha de app" gerada em
# myaccount.google.com/apppasswords (exige verificação em duas etapas ativada),
# não a senha normal da conta.
GMAIL_USER="seu-email@gmail.com"
GMAIL_APP_PASSWORD=""
EMAIL_FROM_NAME="Seu Nome"

# --- Upstash QStash (lembretes agendados) ---
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# --- Geral ---
# URL pública do app, usada para montar links em e-mails (confirmação/cancelamento).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Segredo compartilhado para autenticar chamadas do Vercel Cron às rotas /api/cron/*.
CRON_SECRET=""
